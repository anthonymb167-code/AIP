// Gesture definitions for live avatar stage triggers
const GESTURES = [
  { id: 'smile', label: 'Warm Smile', quote: "Always in your corner—let's make today count!" },
  { id: 'smirk', label: 'Knowing Smirk', quote: "Already two steps ahead of that problem. Watch this." },
  { id: 'wink', label: 'Playful Wink', quote: "Don't worry—our secret. We've got this handled." },
  { id: 'laugh', label: 'Encouraging Laugh', quote: "Haha! Now that's the kind of brilliance I like to see!" },
  { id: 'nod', label: 'Attentive Nod', quote: "I hear you completely. Walk me through every detail." }
];

export default function App() {
  // Selected Archetype
  const [archetypeKey, setArchetypeKey] = useState('GOTH');
  const archetype = ARCHETYPES[archetypeKey];

  // Customizable Visual Traits
  const [glasses, setGlasses] = useState(ARCHETYPES.GOTH.defaults.glasses);
  const [coatStyle, setCoatStyle] = useState(ARCHETYPES.GOTH.defaults.coatStyle);
  const [hairColor, setHairColor] = useState(ARCHETYPES.GOTH.defaults.hairColor);
  const [eyeColor, setEyeColor] = useState(ARCHETYPES.GOTH.defaults.eyeColor);
  const [maturityMode, setMaturityMode] = useState('timeless'); // 'timeless' | 'maturing'

  // Live Gesture & Speech Bubble State
  const [activeGesture, setActiveGesture] = useState('smirk');
  const [gestureBubble, setGestureBubble] = useState(GESTURES[1].quote);
  const [isAnimatingGesture, setIsAnimatingGesture] = useState(false);

  // Multi-Modal Fine-Tuning Controls
  const [promptInput, setPromptInput] = useState('');
  const [appliedModifiers, setAppliedModifiers] = useState(['Sharp smirk calibrated', 'Incorruptible loyalty core locked']);
  const [warmth, setWarmth] = useState(85);
  const [wit, setWit] = useState(80);
  const [pacing, setPacing] = useState(70);
  const [adaptiveSelfTuning, setAdaptiveSelfTuning] = useState(true);

  // Lifespan Decade State
  const [selectedDecadeId, setSelectedDecadeId] = useState('11-20');
  const currentDecade = DECADE_STAGES.find((d) => d.id === selectedDecadeId) || DECADE_STAGES[1];

  // Mini-Chat State
  const [chatInput, setChatInput] = useState('');
  const [chatHistory, setChatHistory] = useState([
    {
      sender: 'aip',
      text: DECADE_STAGES[1].script,
      tag: 'Greeting • Ages 11–20'
    }
  ]);
  const chatEndRef = useRef(null);

  // Switch archetype and apply its default styling
  const handleSelectArchetype = (key) => {
    setArchetypeKey(key);
    const defs = ARCHETYPES[key].defaults;
    setGlasses(defs.glasses);
    setCoatStyle(defs.coatStyle);
    setHairColor(defs.hairColor);
    setEyeColor(defs.eyeColor);
    triggerGesture('smirk', `Switched to ${ARCHETYPES[key].name}—same core, fresh look.`);
  };

  // Trigger animated facial/body gesture
  const triggerGesture = (gestureId, customText = null) => {
    setActiveGesture(gestureId);
    const found = GESTURES.find((g) => g.id === gestureId);
    setGestureBubble(customText || (found ? found.quote : 'Ready when you are!'));
    setIsAnimatingGesture(true);
    setTimeout(() => setIsAnimatingGesture(false), 650);
  };

  // Handle Decade Timeline Change
  const handleSelectDecade = (decade) => {
    setSelectedDecadeId(decade.id);
    triggerGesture(decade.defaultGesture, decade.script);
    setChatHistory([
      {
        sender: 'aip',
        text: decade.script,
        tag: `Stage Script • ${decade.label}`
      }
    ]);
  };

  // Parse natural language prompt modifiers (e.g., "silver glasses", "trench coat", "smile", "blue eyes")
  const handleApplyPromptModifier = (e) => {
    e.preventDefault();
    if (!promptInput.trim()) return;
    const text = promptInput.toLowerCase();
    const notes = [];

    if (text.includes('silver') || text.includes('glass')) {
      setGlasses('silver');
      notes.push('Silver-rimmed glasses equipped');
    } else if (text.includes('round')) {
      setGlasses('round');
      notes.push('Round literary frames equipped');
    } else if (text.includes('visor') || text.includes('cyber')) {
      setGlasses('visor');
      notes.push('HUD optical visor equipped');
    } else if (text.includes('no glass') || text.includes('remove glass')) {
      setGlasses('none');
      notes.push('Glasses removed');
    }

    if (text.includes('trench')) {
      setCoatStyle('trench');
      notes.push('High-collar trench coat tailored');
    } else if (text.includes('blazer') || text.includes('scholar')) {
      setCoatStyle('blazer');
      notes.push('Academic blazer tailored');
    } else if (text.includes('turtle')) {
      setCoatStyle('turtleneck');
      notes.push('Minimalist turtleneck tailored');
    }

    if (text.includes('blue eye')) {
      setEyeColor('#38bdf8');
      notes.push('Electric blue iris hue');
    } else if (text.includes('emerald') || text.includes('green eye')) {
      setEyeColor('#10b981');
      notes.push('Emerald iris hue');
    } else if (text.includes('amber') || text.includes('gold eye')) {
      setEyeColor('#f59e0b');
      notes.push('Warm amber iris hue');
    } else if (text.includes('purple') || text.includes('violet')) {
      setEyeColor('#a855f7');
      notes.push('Amethyst iris hue');
    }

    if (text.includes('silver hair') || text.includes('white hair')) {
      setHairColor('#e2e8f0');
      notes.push('Silver-white hair tone');
    } else if (text.includes('black hair') || text.includes('dark hair')) {
      setHairColor('#0f172a');
      notes.push('Midnight black hair tone');
    }

    if (text.includes('wink')) {
      triggerGesture('wink', "Wink locked in—how's this look on me?");
    } else if (text.includes('smirk')) {
      triggerGesture('smirk', "Sharper smirk calibrated. Ready for anything.");
    } else if (text.includes('laugh')) {
      triggerGesture('laugh', "Haha, dialed up the positive energy!");
    } else {
      triggerGesture('smile', "Fine-tuned to your exact vision—core traits 100% locked.");
    }

    const summary = notes.length > 0 ? notes.join(' • ') : `Custom vibe applied: "${promptInput}"`;
    setAppliedModifiers((prev) => [summary, ...prev.slice(0, 3)]);
    setPromptInput('');
  };

  // Handle interactive mini-chat messages
  const handleSendChat = (presetText = null) => {
    const message = (presetText || chatInput).trim();
    if (!message) return;

    const userMsg = { sender: 'user', text: message };
    const lower = message.toLowerCase();

    let replyText = currentDecade.sampleResponses.default;
    let replyGesture = 'smile';

    if (lower.includes('book') || lower.includes('literature') || lower.includes('essay') || lower.includes('school') || lower.includes('study') || lower.includes('read')) {
      replyText = currentDecade.sampleResponses.book;
      replyGesture = 'nod';
    } else if (lower.includes('roadblock') || lower.includes('trouble') || lower.includes('stuck') || lower.includes('problem') || lower.includes('stress') || lower.includes('help')) {
      replyText = currentDecade.sampleResponses.roadblock;
      replyGesture = 'smirk';
    } else if (lower.includes('joke') || lower.includes('laugh') || lower.includes('fun')) {
      replyText = "Haha, you always know how to keep things interesting! Whatever comes next, we're tackling it with full momentum.";
      replyGesture = 'laugh';
    }

    // Add subtle archetype flavor prefix
    const stylePrefix =
      archetypeKey === 'GOTH'
        ? '[Dark Wit • Core Locked] '
        : archetypeKey === 'SCHOLAR'
        ? '[Literary Insight] '
        : archetypeKey === 'CYBER'
        ? '[Tactical Scan Complete] '
        : '';

    const aipMsg = {
      sender: 'aip',
      text: `${stylePrefix}${replyText}`,
      tag: `${archetype.name} • ${currentDecade.label}`
    };

    setChatHistory((prev) => [...prev, userMsg, aipMsg]);
    triggerGesture(replyGesture, replyText);
    if (!presetText) setChatInput('');
  };

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [chatHistory]);

  // Determine age maturity visual cues (e.g. subtle temples/maturity lines in 41+ when maturing mode is active)
  const isMatureStage =
    maturityMode === 'maturing' && ['41-50', '51-60', '61+'].includes(selectedDecadeId);
  const isSeniorStage = maturityMode === 'maturing' && selectedDecadeId === '61+';

  return (
    <div className="min-h-screen w-full bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-purple-500 selection:text-white">
      {/* TOP STUDIO HEADER */}
      <header className="border-b border-slate-800/90 bg-slate-900/80 backdrop-blur-md px-6 py-4 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-30">
        <div className="flex items-center gap-3">
          <div className={`w-11 h-11 rounded-2xl ${archetype.accentSolid} flex items-center justify-center shadow-lg ${archetype.glowShadow} transition-colors duration-300`}>
            <Sparkles className="w-6 h-6 text-white" />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h1 className="text-lg font-extrabold tracking-tight text-white">
                AIP IDENTITY STUDIO
              </h1>
              <span className={`text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full border ${archetype.accentBorder} ${archetype.accentBg} ${archetype.accentText}`}>
                All-Ages Companion
              </span>
            </div>
            <p className="text-xs text-slate-400">
              AI Person Customization, Expressive Gesture Stage & Lifespan Evolution Engine
            </p>
          </div>
        </div>

        {/* PERMANENT CORE ANCHOR BADGE */}
        <div className="flex items-center gap-2.5 bg-slate-950/90 border border-emerald-500/40 px-3.5 py-2 rounded-xl shadow-inner">
          <div className="w-7 h-7 rounded-lg bg-emerald-500/15 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
            <Lock className="w-3.5 h-3.5" />
          </div>
          <div>
            <div className="flex items-center gap-1.5">
              <span className="text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                Core Anchor Locked
              </span>
              <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" />
            </div>
            <p className="text-[10px] text-slate-400">
              Incorruptible • Brilliant • Loyal • Positive Across All Avatars
            </p>
          </div>
        </div>
      </header>

      {/* MAIN 3-COLUMN STUDIO WORKSPACE */}
      <main className="flex-1 max-w-[1600px] w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* LEFT COLUMN: MULTI-MODAL FINE-TUNING CONTROLS (4 cols) */}
        <section className="lg:col-span-4 flex flex-col gap-5">
          
          {/* 1. Archetype Selector Cards */}
          <div className="bg-slate-900/70 border border-slate-800 rounded-2xl p-4 backdrop-blur">
            <div className="flex items-center justify-between mb-3">
              <h2 className="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
                <Layers className={`w-4 h-4 ${archetype.accentText}`} />
                <span>1. Avatar Style Archetypes</span>
              </h2>
              <span className="text-[10px] text-slate-500">Outer Makeup Only</span>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2">
              {Object.values(ARCHETYPES).map((item) => {
                const isSelected = item.id === archetypeKey;
                return (
                  <button
                    key={item.id}
                    onClick={() => handleSelectArchetype(item.id)}
                    className={`text-left p-3 rounded-xl border transition-all duration-200 flex items-center justify-between ${
                      isSelected
                        ? `${item.accentBorder} ${item.accentBg} shadow-md ${item.glowShadow}`
                        : 'border-slate-800 bg-slate-950/60 hover:border-slate-700'
                    }`}
                  >
                    <div>
                      <div className={`text-sm font-bold ${isSelected ? 'text-white' : 'text-slate-300'}`}>
                        {item.name}
                      </div>
                      <div className="text-[11px] text-slate-400 mt-0.5">{item.tagline}</div>
                    </div>
                    {isSelected && <CheckCircle2 className={`w-4 h-4 shrink-0 ${item.accentText}`} />}
                  </button>
                );
              })}
            </div>
          </div>

          {/* 2. Quick Visual & Maturity Accents */}
          <div className="bg-slate-900/70 border border-slate-800 rounded-2xl p-4 backdrop-blur flex flex-col gap-3.5">
            <h2 className="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
              <Sliders className={`w-4 h-4 ${archetype.accentText}`} />
              <span>2. Fine-Tune Details & Maturity</span>
            </h2>

            {/* Eyewear & Collar Controls */}
            <div className="grid grid-cols-2 gap-3 text-xs">
              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Eyewear</label>
                <select
                  value={glasses}
                  onChange={(e) => setGlasses(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-2 text-slate-200 focus:outline-none focus:border-slate-600"
                >
                  <option value="none">None</option>
                  <option value="silver">Silver-Rimmed</option>
                  <option value="round">Round Literary</option>
                  <option value="visor">Cyber Optical Visor</option>
                </select>
              </div>

              <div>
                <label className="text-[11px] text-slate-400 block mb-1">Attire / Collar</label>
                <select
